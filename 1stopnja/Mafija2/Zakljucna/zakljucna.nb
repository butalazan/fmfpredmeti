Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"8", ",", 
            RowBox[{"10", "*", "t"}]}], "]"}], 
          RowBox[{"-", "10"}]], "*", 
         RowBox[{"\[ExponentialE]", "/", 
          RowBox[{"HeavisideTheta", "[", 
           RowBox[{"t", "-", "0.08"}], "]"}]}]}], "-", 
        RowBox[{
         RowBox[{"BesselJ", "[", 
          RowBox[{"2", ",", 
           RowBox[{"50", "*", "t"}]}], "]"}], 
         FractionBox[
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "2"}], "*", "t"}]], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["\[ExponentialE]", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"t", "+", "0.4"}], ")"}], "6"]]}], ")"}]], "*", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", "t"}]]}], "-", 
        RowBox[{
         RowBox[{"Sin", "[", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "0.5"}], "t"}]], "]"}], "/", "6"}], "+", 
        RowBox[{
         RowBox[{"BesselJ", "[", 
          RowBox[{"3", ",", 
           RowBox[{
            RowBox[{"-", "10"}], "*", 
            RowBox[{"Log", "[", "t", "]"}]}]}], "]"}], "*", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"t", "-", "0.5"}], ")"}]}]], 
         FractionBox[
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "2"}], "t"}]], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["\[ExponentialE]", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"t", "+", "0.5"}], ")"}], "2"]]}], ")"}]]}], "-", 
        RowBox[{
         RowBox[{"BesselJ", "[", 
          RowBox[{"1", ",", 
           RowBox[{"10", "*", 
            RowBox[{"Log", "[", "t", "]"}]}]}], "]"}], "*", 

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"3", ",", 
            RowBox[{"9", "*", "t"}]}], "]"}], "6"]}], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "2"}], "*", "t"}]], "*", 
        FractionBox["1", 
         RowBox[{"HeavisideTheta", "[", 
          RowBox[{"t", "-", "0.02"}], "]"}]]}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{"SphericalBesselJ", "[", 
          RowBox[{"3", ",", 
           RowBox[{"19", "*", "t"}]}], "]"}], "20"], "*", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "2"}], "t"}]]}], "-", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"4", "/", 
          SuperscriptBox["t", 
           RowBox[{"1", "/", "3"}]]}], "]"}], "*", 
        FractionBox[
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "2"}], "*", "t"}]], 
         RowBox[{"50", "*", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["\[ExponentialE]", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"t", "+", "0.6"}], ")"}], "6"]]}], ")"}]}]]}], "+", 
       FractionBox["1", 
        RowBox[{"10000", "*", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"t", "-", "0.01"}], ")"}], "1"]}]]}], ")"}], "/", "1.4"}], 
    "+", "0.63295"}], ",", 

         RowBox[{"Sin", "[", 
          RowBox[{"10", "/", 
           SuperscriptBox["t", 
            RowBox[{"1", "/", "3"}]]}], "]"}], "*", 
         FractionBox["1", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["\[ExponentialE]", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"t", "+", "0.6"}], ")"}], "2"]]}], ")"}]]}]}], ")"}]}],
      "*", 
     RowBox[{
      SuperscriptBox["2", 

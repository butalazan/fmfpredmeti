         RowBox[{"\[Nu]", ",", 
          RowBox[{
           RowBox[{"\[Zeta]", "[", 
            RowBox[{"\[Nu]", ",", "n"}], "]"}], "*", "r"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "1"}], "}"}]}], "]"}], ")"}], 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["r", "2"], "*", 
       SuperscriptBox[
        RowBox[{"SphericalBesselJ", "[", 
         RowBox[{"\[Nu]", ",", 
          RowBox[{
           RowBox[{"\[Zeta]", "[", 
            RowBox[{"\[Nu]", ",", "n"}], "]"}], "*", "r"}]}], "]"}], "2"]}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "1"}], "}"}]}], "]"}]]}], ";"}]}], "Input",

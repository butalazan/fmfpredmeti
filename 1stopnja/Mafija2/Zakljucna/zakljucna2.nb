Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"testQ", "[", 
    RowBox[{"\[Nu]_", ",", "\[Mu]_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"LegendreQ", "[", 
       RowBox[{"\[Nu]", ",", "\[Mu]", ",", "z"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0", ",", "1"}], "}"}]}], "]"}], 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"LegendreQ", "[", 
        RowBox[{"\[Nu]", ",", "\[Mu]", ",", "z"}], "]"}], "2"], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0", ",", "1"}], "}"}]}], "]"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testj", "[", 
    RowBox[{"\[Nu]_", ",", "n_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["r", "2"], "*", 
